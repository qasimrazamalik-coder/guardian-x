<Window x:Class="GuardianX.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Guardian X" Width="1440" Height="920" MinWidth="1180" MinHeight="720"
        Background="#04060A" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/guardian.ico">
  <Grid>
    <wv2:WebView2 x:Name="Web" DefaultBackgroundColor="#04060A" />
    <TextBlock x:Name="Fallback" Visibility="Collapsed" Foreground="#E8EDF2" FontSize="15" Margin="40"
               TextWrapping="Wrap" VerticalAlignment="Center" HorizontalAlignment="Center" MaxWidth="560"/>
  </Grid>
</Window>
