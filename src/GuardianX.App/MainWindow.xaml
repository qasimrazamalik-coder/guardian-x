<Window x:Class="GuardianX.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:GuardianX.App.Views"
        Title="Guardian X" Width="1120" Height="860" MinWidth="980" MinHeight="640"
        Background="{StaticResource Bg}" WindowStartupLocation="CenterScreen"
        Icon="pack://application:,,,/Assets/guardian.ico"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Grid Margin="18,14,18,12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Margin="6,0,6,10">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
        <Image Source="pack://application:,,,/Assets/guardian.ico" Width="28" Height="28" Margin="0,0,10,0"/>
        <StackPanel>
          <TextBlock Text="Guardian X" FontFamily="{StaticResource Display}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
          <TextBlock x:Name="DeviceText" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Muted}"/>
        </StackPanel>
        <Border x:Name="StateChip" CornerRadius="10" Padding="10,3" Margin="16,0,0,0" VerticalAlignment="Center" Background="#14302A">
          <TextBlock x:Name="StateText" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Good}"/>
        </Border>
      </StackPanel>
      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
        <RadioButton x:Name="TabOverview" Content="Overview" Style="{StaticResource TabButton}" IsChecked="True" Checked="OnTab"/>
        <RadioButton x:Name="TabHistory" Content="History" Style="{StaticResource TabButton}" Checked="OnTab"/>
        <RadioButton x:Name="TabSettings" Content="Settings" Style="{StaticResource TabButton}" Checked="OnTab"/>
      </StackPanel>
    </Grid>

    <!-- Overview -->
    <ScrollViewer x:Name="OverviewPage" Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel>
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>

          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <v:HealthRing x:Name="Ring" Width="250" Height="250" HorizontalAlignment="Center"/>
              <TextBlock x:Name="CapacityText" Style="{StaticResource Body}" Foreground="{StaticResource Ink}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,-14,0,4"/>
              <TextBlock x:Name="CyclesText" Style="{StaticResource Body}" HorizontalAlignment="Center" TextAlignment="Center"/>
              <Border Background="#0F1318" CornerRadius="10" Padding="14,12" Margin="0,16,0,0">
                <StackPanel>
                  <TextBlock Text="WEAR SPEED" Style="{StaticResource Eyebrow}" Margin="0,0,0,6"/>
                  <TextBlock x:Name="WearSpeedText" FontFamily="{StaticResource Display}" FontSize="18" FontWeight="SemiBold" Foreground="{StaticResource Ink}"/>
                  <Grid Margin="0,10,0,4" Height="8">
                    <Border Background="#1F2630" CornerRadius="4"/>
                    <Border x:Name="WearTypicalBar" Background="#3A4A5C" CornerRadius="4" HorizontalAlignment="Left"/>
                    <Border x:Name="WearYoursBar" CornerRadius="4" HorizontalAlignment="Left" Height="4" Background="{StaticResource Bad}"/>
                  </Grid>
                  <TextBlock x:Name="WearCompareText" Style="{StaticResource Body}" FontSize="12"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <Grid Grid.Column="1">
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <Border Style="{StaticResource CardBorder}">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                  <TextBlock Text="RIGHT NOW" Style="{StaticResource Eyebrow}"/>
                  <TextBlock x:Name="PercentText" Style="{StaticResource Big}" FontSize="48"/>
                  <TextBlock x:Name="FlowText" Style="{StaticResource Body}" Foreground="{StaticResource Ink}" FontSize="14"/>
                </StackPanel>
                <Grid Grid.Column="1" Margin="24,4,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                  </Grid.ColumnDefinitions>
                  <Grid.RowDefinitions>
                    <RowDefinition/><RowDefinition/><RowDefinition/><RowDefinition/>
                  </Grid.RowDefinitions>
                  <TextBlock Text="Power" Style="{StaticResource Body}" Margin="0,0,18,8"/>
                  <TextBlock x:Name="PowerText" Grid.Column="1" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Ink}" FontSize="13"/>
                  <TextBlock Grid.Row="1" Text="Voltage" Style="{StaticResource Body}" Margin="0,0,18,8"/>
                  <TextBlock x:Name="VoltText" Grid.Row="1" Grid.Column="1" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Ink}" FontSize="13"/>
                  <TextBlock Grid.Row="2" Text="Temperature" Style="{StaticResource Body}" Margin="0,0,18,8"/>
                  <TextBlock x:Name="TempText" Grid.Row="2" Grid.Column="1" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Ink}" FontSize="13"/>
                  <TextBlock Grid.Row="3" Text="Full on charger" Style="{StaticResource Body}" Margin="0,0,18,0"/>
                  <TextBlock x:Name="HoldText" Grid.Row="3" Grid.Column="1" FontFamily="{StaticResource Mono}" Foreground="{StaticResource Ink}" FontSize="13"/>
                </Grid>
              </Grid>
            </Border>

            <Border Grid.Row="1" Style="{StaticResource CardBorder}">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="Auto"/>
                  <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <DockPanel>
                  <TextBlock Text="LAST 24 HOURS" Style="{StaticResource Eyebrow}"/>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,0,10">
                    <Rectangle Width="14" Height="3" Fill="{StaticResource Info}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="on charger" Style="{StaticResource Eyebrow}" Margin="0,0,14,0"/>
                    <Rectangle Width="14" Height="3" Fill="{StaticResource Warn}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <TextBlock Text="on battery" Style="{StaticResource Eyebrow}" Margin="0"/>
                  </StackPanel>
                </DockPanel>
                <v:LineChart x:Name="DayChart" Grid.Row="1" MinHeight="170"/>
              </Grid>
            </Border>
          </Grid>
        </Grid>

        <UniformGrid Columns="3">
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <TextBlock Text="STRESS TODAY" Style="{StaticResource Eyebrow}"/>
              <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="StressScore" Style="{StaticResource Big}"/>
                <TextBlock x:Name="StressLevel" FontFamily="{StaticResource Mono}" FontSize="12" VerticalAlignment="Bottom" Margin="8,0,0,8"/>
              </StackPanel>
              <TextBlock x:Name="StressDetail" Style="{StaticResource Body}" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <TextBlock Text="LAST SLEEP" Style="{StaticResource Eyebrow}"/>
              <TextBlock x:Name="SleepBig" Style="{StaticResource Big}"/>
              <TextBlock x:Name="SleepDetail" Style="{StaticResource Body}" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <TextBlock x:Name="GpuTitle" Text="NVIDIA GPU" Style="{StaticResource Eyebrow}"/>
              <TextBlock x:Name="GpuBig" Style="{StaticResource Big}"/>
              <TextBlock x:Name="GpuDetail" Style="{StaticResource Body}" Margin="0,6,0,0"/>
            </StackPanel>
          </Border>
        </UniformGrid>

        <Border Style="{StaticResource CardBorder}">
          <StackPanel>
            <TextBlock Text="WHAT TO DO" Style="{StaticResource Eyebrow}"/>
            <ItemsControl x:Name="TipsList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,4,0,12">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="4"/>
                      <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border CornerRadius="2" Background="{Binding Accent}"/>
                    <StackPanel Grid.Column="1" Margin="14,0,0,0">
                      <TextBlock Text="{Binding Title}" FontFamily="{StaticResource Display}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Ink}" TextWrapping="Wrap"/>
                      <TextBlock Text="{Binding Body}" Style="{StaticResource Body}" Margin="0,3,0,0"/>
                    </StackPanel>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
        <TextBlock x:Name="ErrorText" Style="{StaticResource Body}" Foreground="{StaticResource Bad}" Margin="8,4" Visibility="Collapsed"/>
      </StackPanel>
    </ScrollViewer>

    <!-- History -->
    <ScrollViewer x:Name="HistoryPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
      <StackPanel>
        <Border Style="{StaticResource CardBorder}">
          <Grid>
            <Grid.RowDefinitions>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="Auto"/>
              <RowDefinition Height="240"/>
            </Grid.RowDefinitions>
            <TextBlock Text="HEALTH OVER TIME" Style="{StaticResource Eyebrow}"/>
            <TextBlock x:Name="TrendText" Grid.Row="1" Style="{StaticResource Body}" Foreground="{StaticResource Ink}" FontSize="14" Margin="0,0,0,12"/>
            <v:LineChart x:Name="HealthChart" Grid.Row="2"/>
          </Grid>
        </Border>
        <Border Style="{StaticResource CardBorder}">
          <StackPanel>
            <TextBlock Text="LAST 14 DAYS" Style="{StaticResource Eyebrow}"/>
            <Grid Margin="0,0,0,6">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/><ColumnDefinition Width="110"/><ColumnDefinition Width="90"/><ColumnDefinition Width="110"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>
              <TextBlock Text="Day" Style="{StaticResource Eyebrow}"/>
              <TextBlock Grid.Column="1" Text="Health" Style="{StaticResource Eyebrow}"/>
              <TextBlock Grid.Column="2" Text="Cycles" Style="{StaticResource Eyebrow}"/>
              <TextBlock Grid.Column="3" Text="Stress" Style="{StaticResource Eyebrow}"/>
              <TextBlock Grid.Column="4" Text="Hours full" Style="{StaticResource Eyebrow}"/>
              <TextBlock Grid.Column="5" Text="Lowest" Style="{StaticResource Eyebrow}"/>
            </Grid>
            <ItemsControl x:Name="DaysList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,5">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="140"/><ColumnDefinition Width="110"/><ColumnDefinition Width="90"/><ColumnDefinition Width="110"/><ColumnDefinition Width="120"/><ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding Day}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Ink}"/>
                    <TextBlock Grid.Column="1" Text="{Binding Health}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Ink}"/>
                    <TextBlock Grid.Column="2" Text="{Binding Cycles}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Ink}"/>
                    <TextBlock Grid.Column="3" Text="{Binding Stress}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{Binding StressBrush}"/>
                    <TextBlock Grid.Column="4" Text="{Binding Full}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Ink}"/>
                    <TextBlock Grid.Column="5" Text="{Binding Lowest}" FontFamily="{StaticResource Mono}" FontSize="12" Foreground="{StaticResource Ink}"/>
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock x:Name="DaysEmpty" Style="{StaticResource Body}" Text="No full days recorded yet." Visibility="Collapsed"/>
          </StackPanel>
        </Border>
        <Border Style="{StaticResource CardBorder}">
          <StackPanel>
            <TextBlock Text="APPS THAT WOKE THE NVIDIA GPU ON BATTERY (7 DAYS)" Style="{StaticResource Eyebrow}"/>
            <TextBlock x:Name="GpuHistoryText" Style="{StaticResource Body}" Foreground="{StaticResource Ink}"/>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <!-- Settings -->
    <ScrollViewer x:Name="SettingsPage" Grid.Row="1" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <StackPanel>
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <TextBlock Text="ALERTS" Style="{StaticResource Eyebrow}"/>
              <CheckBox x:Name="OptFull" Style="{StaticResource Toggle}" Content="Tell me when it sits at 100% on the charger" Click="OnSettingChanged"/>
              <StackPanel Orientation="Horizontal" Margin="0,2,0,8">
                <TextBlock Text="after" Style="{StaticResource Body}" VerticalAlignment="Center"/>
                <ComboBox x:Name="OptFullMinutes" Width="110" Margin="8,0" SelectionChanged="OnSettingChanged">
                  <ComboBoxItem Content="1 hour" Tag="60"/>
                  <ComboBoxItem Content="2 hours" Tag="120"/>
                  <ComboBoxItem Content="4 hours" Tag="240"/>
                </ComboBox>
              </StackPanel>
              <CheckBox x:Name="OptLow" Style="{StaticResource Toggle}" Content="Warn me at 15% on battery" Click="OnSettingChanged"/>
              <CheckBox x:Name="OptSleep" Style="{StaticResource Toggle}" Content="Tell me when it drains unusually in sleep" Click="OnSettingChanged"/>
              <CheckBox x:Name="OptGpu" Style="{StaticResource Toggle}" Content="Tell me when an app wakes the NVIDIA GPU on battery" Click="OnSettingChanged"/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <TextBlock Text="START-UP" Style="{StaticResource Eyebrow}"/>
              <CheckBox x:Name="OptStartup" Style="{StaticResource Toggle}" Content="Start with Windows (in the tray)" Click="OnSettingChanged"/>
              <TextBlock Style="{StaticResource Body}" FontSize="12" Margin="0,6,0,0"
                         Text="Guardian X needs to run to record history. It reads the battery once a minute and uses very little power."/>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <TextBlock Text="CAP THE CHARGE AT 80%" Style="{StaticResource Eyebrow}"/>
              <TextBlock Style="{StaticResource Body}">
                On your OMEN the charge limit lives in the BIOS, so no Windows app can switch it on for you. Restart, press F10 to open BIOS Setup,
                go to Advanced (or Configuration) and turn on Adaptive Battery Optimizer, then save with F10. Guardian X will show the effect as fewer hours at 100%.
              </TextBlock>
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Grid.Column="1">
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <TextBlock Text="YOUR DATA" Style="{StaticResource Eyebrow}"/>
              <TextBlock x:Name="DataText" Style="{StaticResource Body}" Margin="0,0,0,12"/>
              <WrapPanel>
                <Button Content="Export CSV" Style="{StaticResource Action}" Click="OnExport"/>
                <Button Content="Open data folder" Style="{StaticResource Action}" Click="OnOpenData"/>
                <Button Content="Delete history" Style="{StaticResource Action}" Click="OnDeleteHistory"/>
              </WrapPanel>
            </StackPanel>
          </Border>
          <Border Style="{StaticResource CardBorder}">
            <StackPanel>
              <TextBlock Text="MAINTENANCE" Style="{StaticResource Eyebrow}"/>
              <WrapPanel>
                <Button x:Name="UpdateButton" Content="Check for updates" Style="{StaticResource Action}" Click="OnUpdate"/>
                <Button Content="Repair" Style="{StaticResource Action}" Click="OnRepair"/>
                <Button Content="Quit Guardian X" Style="{StaticResource Action}" Click="OnQuit"/>
              </WrapPanel>
              <TextBlock x:Name="MaintText" Style="{StaticResource Body}" Margin="0,4,0,0"/>
              <TextBlock Style="{StaticResource Body}" FontSize="12" Margin="0,10,0,0"
                         Text="To uninstall, use Windows Settings &gt; Apps &gt; Installed apps &gt; Guardian X. You'll be asked whether to keep your history."/>
              <TextBlock x:Name="VersionText" FontFamily="{StaticResource Mono}" FontSize="11" Foreground="{StaticResource Faint}" Margin="0,12,0,0"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </Grid>
    </ScrollViewer>
  </Grid>
</Window>
